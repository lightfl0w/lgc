    while (i) {
        if (ast_kind[i] == NODE_LET) sym_global_add(ast_v[i], ast_b[i]);
        i = ast_next[i];
    }
    i = ast_a[parse_root];
    while (i) {
        if (ast_kind[i] == NODE_FUNCTION) {
            if (sym_nfunc >= 256) util_die(0, "too many functions");
            sym_func_name[sym_nfunc] = ast_v[i]; sym_func_label[sym_nfunc] = emit_new_label();
            pc = 0;
