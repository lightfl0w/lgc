func x64_gen_stmt(n) {
    let int t = ast_kind[n];
    let int i = 0;
    let int l1 = 0;
    let int l2 = 0;
    let int l3 = 0;
    let int l4 = 0;
    let int sn = 0;
    let int so = 0;
