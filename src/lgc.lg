        x64_gen_stmt(ast_b[n]);
        x64_jmp_rel(l2);
        emit_put_label(l1);
        if (ast_v[n]) x64_gen_stmt(ast_v[n]);
        emit_put_label(l2);
        return 0;
    }
    if (t == NODE_WHILE) {
        l1 = emit_new_label(); l2 = emit_new_label();
        sym_break_label[sym_nloop] = l2; sym_cont_label[sym_nloop] = l1; sym_nloop = sym_nloop + 1;
        emit_put_label(l1);
        x64_gen_expr(ast_a[n]);
        x64_test_rax();
        x64_je_rel(l2);
        x64_gen_stmt(ast_b[n]);
        x64_jmp_rel(l1);
        emit_put_label(l2);
        sym_nloop = sym_nloop - 1;
        return 0;
    }
    if (t == NODE_FOR) {
        l1 = emit_new_label(); l2 = emit_new_label(); l3 = emit_new_label(); l4 = emit_new_label();
        sn = sym_nlocal; so = sym_frame_off;               
        if (ast_a[n]) x64_gen_stmt(ast_a[n]);
        sym_break_label[sym_nloop] = l4; sym_cont_label[sym_nloop] = l2; sym_nloop = sym_nloop + 1;
        x64_jmp_rel(l3);
        emit_put_label(l1);                          
        x64_gen_stmt(ast_c[n]);
        emit_put_label(l2);                          
        if (ast_v[n]) x64_gen_expr(ast_v[n]);
        emit_put_label(l3);                          
        if (ast_b[n]) { x64_gen_expr(ast_b[n]); x64_test_rax(); x64_je_rel(l4); }
        x64_jmp_rel(l1);
        emit_put_label(l4);
        sym_nloop = sym_nloop - 1;
        sym_nlocal = sn; sym_frame_off = so;
        return 0;
    }
    if (t == NODE_BREAK) { x64_jmp_rel(sym_break_label[sym_nloop - 1]); return 0; }
    if (t == NODE_CONTINUE) { x64_jmp_rel(sym_cont_label[sym_nloop - 1]); return 0; }
    if (t == NODE_RETURN) { x64_gen_expr(ast_a[n]); x64_leave_ret(); return 0; }
    x64_gen_expr(n);
    return 0;
}


func x64_gen_func(n) {
    let int p = 0;
    let int k = 0;
    emit_put_label(sym_func_label[sym_func_find(ast_v[n])]);
    x64_prologue();
    sym_nlocal = 0; sym_frame_off = 0;
    p = ast_a[n];
    if (p) {
        k = sym_local_add(ast_v[p], TYPE_INT);
        x64_mov_rax_rdi();
        x64_store_rbp(sym_local_off[k]);
        p = ast_next[p];
    }
    k = 1;
    while (p) {
        sym_local_add(ast_v[p], TYPE_INT);
        x64_load_rbp(16 + 8 * (k - 1));
        x64_store_rbp(sym_local_off[sym_nlocal - 1]);
        p = ast_next[p];
        k = k + 1;
    }
    x64_gen_stmt(ast_b[n]);
    x64_leave_ret();
}

func x64_emit_entry() {
    let int i = 0;
    let int g = 0;
    let int f = 0;
    if (out_freestanding == 0) {
        i = 0;
        while (i < 8) {
            g = sym_global_find(drv_argv_names[i]);
            if (g >= 0) {
                x64_mov_rax_rsp(16 + 8 * i);
                x64_store_glob(sym_global_off[g]);
            }
            i = i + 1;
        }
    }
    x64_prologue();
    sym_nlocal = 0; sym_frame_off = 0;
    i = ast_a[parse_root];
    while (i) {
        if ((ast_kind[i] != NODE_FUNCTION) && (ast_kind[i] != NODE_EXTERN_FUNC) && (ast_kind[i] != NODE_EXTERN_GLOB)) {
            g = sym_global_find(ast_v[i]);
            if ((ast_kind[i] == NODE_LET) && (g >= 0)) {
                if (ast_a[i]) {
                    x64_gen_expr(ast_a[i]);
                    if (type_is_char(sym_global_ty[g])) x64_store_glob_byte(sym_global_off[g]);
                    else x64_store_glob(sym_global_off[g]);
                }
            }
            else x64_gen_stmt(i);
        }
        i = ast_next[i];
    }
    f = sym_func_find(out_entry_name);
    if (f >= 0) {
        x64_call_rel(sym_func_label[f]);
        if (out_freestanding) { emit_u8(235); emit_u8(254); }
        else { x64_mov_rdi_rax(); x64_mov_imm(SYS_EXIT); emit_u8(15); emit_u8(5); }
    } else {
        if (out_freestanding) { emit_u8(235); emit_u8(254); }
        else { x64_mov_imm(SYS_EXIT); emit_u8(49); emit_u8(255); emit_u8(15); emit_u8(5); }
    }
    return 0;
}

