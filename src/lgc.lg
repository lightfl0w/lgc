            j = emit_new_label(); k = emit_new_label();
            x64_gen_expr(ast_a[n]); x64_test_rax();
            if (i == BIN_AND) x64_je_rel(j); else x64_jne_rel(j);
            x64_gen_expr(ast_b[n]); x64_test_rax();
            if (i == BIN_AND) x64_je_rel(j); else x64_jne_rel(j);
            if (i == BIN_AND) x64_mov_imm(1); else { emit_u8(72); emit_u8(49); emit_u8(192); }
