                x64_cmp_rax_imm(ast_v[ast_b[n]]);
                x64_setcc_al(i);
                return 0;
            }
            x64_gen_expr(ast_a[n]);
            if (x64_try_leaf_rcx(ast_b[n])) { x64_cmp_rax_rcx(); x64_setcc_al(i); return 0; }
            x64_gen_expr(ast_b[n]); x64_push_rax();
            x64_gen_expr(ast_a[n]); x64_pop_rbx();
            x64_cmp_rax_rbx();
            x64_setcc_al(i);
            return 0;
        }
        x64_gen_expr(ast_a[n]);
        if ((i <= BIN_MUL) && x64_try_leaf_rcx(ast_b[n])) {
            if (i == BIN_ADD) { x64_add_rax_rcx(); return 0; }
            if (i == BIN_SUB) { x64_sub_rax_rcx(); return 0; }
            x64_mul_rax_rcx();
            return 0;
        }
        if (((i == BIN_DIV) || (i == BIN_MOD)) && x64_try_leaf_rcx(ast_b[n])) {
            x64_div_rcx();
            if (i == BIN_MOD) { emit_u8(72); emit_u8(137); emit_u8(208); return 0; }
            return 0;
        }
        if ((i == BIN_BOR) && x64_try_leaf_rcx(ast_b[n])) { x64_or_rax_rcx(); return 0; }
        if ((i == BIN_BAND) && x64_try_leaf_rcx(ast_b[n])) { x64_and_rax_rcx(); return 0; }
        if ((i == BIN_BXOR) && x64_try_leaf_rcx(ast_b[n])) { x64_xor_rax_rcx(); return 0; }
        if ((i == BIN_SHL) && x64_try_leaf_rcx(ast_b[n])) { x64_shl_rax_cl(); return 0; }
        if ((i == BIN_SHR) && x64_try_leaf_rcx(ast_b[n])) { x64_sar_rax_cl(); return 0; }
        x64_push_rax();
        x64_gen_expr(ast_b[n]); x64_pop_rbx();
        if (i == BIN_ADD) { x64_add_rbx_rax(); return 0; }
        if (i == BIN_SUB) { x64_sub_rbx_rax(); return 0; }
        if (i == BIN_MUL) { x64_mul_rbx(); return 0; }
        if (i == BIN_BOR) { x64_or_rax_rbx(); return 0; }
        if (i == BIN_BAND) { x64_and_rax_rbx(); return 0; }
        if (i == BIN_BXOR) { x64_xor_rax_rbx(); return 0; }
