    if (t == NODE_ADDR)   { x64_gen_addr(ast_a[n]); return 0; }
    if (t == NODE_DEREF) {
        x64_gen_expr(ast_a[n]);
        if (type_is_char(type_of_expr(n))) { x64_loadz_rax(); return 0; }
