        i = sym_global_find(ast_v[n]);
        if (i >= 0) {
            if (type_kind(sym_global_ty[i]) == 2) { x64_lea_rip_glob(sym_global_off[i]); return 0; }
            if (type_is_char(sym_global_ty[i])) { x64_loadz_glob(sym_global_off[i]); return 0; }
            x64_load_glob(sym_global_off[i]);
            return 0;
