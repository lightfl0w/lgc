        emit_u8(72); emit_u8(247); emit_u8(216);
        emit_u8(65); emit_u8(187); emit_u32(1);
        emit_u8(106); emit_u8(10); emit_u8(89);
        emit_u8(72); emit_u8(141); emit_u8(117); emit_u8(255);
        emit_u8(72); emit_u8(49); emit_u8(210);
        emit_u8(72); emit_u8(247); emit_u8(241);
        emit_u8(128); emit_u8(194); emit_u8(48);
        emit_u8(72); emit_u8(255); emit_u8(206);
        emit_u8(136); emit_u8(22);
        x64_test_rax();
        emit_u8(117); emit_u8(237);
        emit_u8(69); emit_u8(133); emit_u8(219);
        emit_u8(116); emit_u8(6);
        emit_u8(72); emit_u8(255); emit_u8(206);
        emit_u8(198); emit_u8(6); emit_u8(45);
        emit_u8(72); emit_u8(141); emit_u8(85); emit_u8(255);
        emit_u8(72); emit_u8(41); emit_u8(242);
        emit_u8(106); emit_u8(1); emit_u8(88);
        x64_mov_rdi_rax();
        emit_u8(15); emit_u8(5);
        x64_leave_ret();
        
