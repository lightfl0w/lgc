    i = 0;
    while (i < emit_npatch) {
        if (emit_patch_kind[i] == 0) emit_poke32(emit_patch_pos[i], emit_label_pos[emit_patch_value[i]] - emit_patch_pos[i] - 4);
        if (emit_patch_kind[i] == 1) emit_poke32(emit_patch_pos[i], emit_label_pos[emit_lit_label] + emit_patch_value[i] - emit_patch_pos[i] - 4);
        if (emit_patch_kind[i] == 2) emit_poke32(emit_patch_pos[i], emit_seg_base + emit_patch_value[i] - (out_load_base + emit_hdr_size + emit_patch_pos[i] + 4));
