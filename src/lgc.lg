    out_put64(72, 0); out_put64(80, out_load_base); out_put64(88, out_load_base);
    out_put64(96, flen); out_put64(104, flen + sym_global_size);
    out_put64(112, OUT_PAGE_SIZE);
    out_fd = syscall(SYS_OPEN, out_name, 577, 493);
    if (out_fd < 0) util_die(0, "cannot create output");
    syscall(SYS_WRITE, out_fd, emit_buf, flen);
    syscall(SYS_CLOSE, out_fd, 0, 0);
}

