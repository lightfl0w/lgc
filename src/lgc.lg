func x64_try_leaf_rcx(n) {
    let int i = 0;
    if (ast_kind[n] != NODE_VARIABLE) return 0;
    i = sym_local_find(ast_v[n]);
    if (i >= 0) {
        if (type_kind(sym_local_ty[i]) != 0) return 0;
        if (type_is_char(sym_local_ty[i])) { emit_u8(15); emit_u8(182); emit_u8(77); emit_u8(sym_local_off[i]); }
        else { emit_u8(72); emit_u8(139); emit_u8(77); emit_u8(sym_local_off[i]); }
        return 1;
    }
    i = sym_global_find(ast_v[n]);
    if ((i < 0) || (type_kind(sym_global_ty[i]) != 0)) return 0;
    if (type_is_char(sym_global_ty[i])) { emit_u8(15); emit_u8(182); emit_u8(13); emit_patch(2, sym_global_off[i]); }
    else { emit_u8(72); emit_u8(139); emit_u8(13); emit_patch(2, sym_global_off[i]); }
    return 1;
}

func x64_gen_addr(n) {
    let int i = 0;
    if (ast_kind[n] == NODE_VARIABLE) {
        i = sym_local_find(ast_v[n]);
        if (i >= 0) { x64_lea_rbp(sym_local_off[i]); return 0; }
        i = sym_global_find(ast_v[n]);
        if (i < 0) util_die(0, "undefined variable");
        x64_lea_rip_glob(sym_global_off[i]);
        return 0;
    }
    if (ast_kind[n] == NODE_DEREF) { x64_gen_expr(ast_a[n]); return 0; }
    if (ast_kind[n] == NODE_INDEX) {
        if (type_kind(type_of_expr(ast_a[n])) == 1) x64_gen_expr(ast_a[n]);
        else x64_gen_addr(ast_a[n]);
        x64_push_rax();
        x64_gen_expr(ast_b[n]);
        x64_pop_rbx();
        i = type_elem_size(type_of_expr(ast_a[n]));
        if (i == 8) x64_shl_rax_3();
        else if (i != 1) { emit_u8(72); emit_u8(105); emit_u8(192); emit_u32(i); }
        x64_add_rbx_rax();
        return 0;
    }
    util_die(0, "not addressable");
    return 0;
}

func x64_gen_expr(n) {
