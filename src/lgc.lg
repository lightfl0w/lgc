        return 0;
    }
    if (t == NODE_INDEX) {
        x64_gen_addr(n);
        if (type_is_char(type_of_expr(n))) { x64_loadz_rax(); return 0; }
        x64_load_rax();
        return 0;
    }
    if (t == NODE_NOT) { x64_gen_expr(ast_a[n]); x64_test_rax(); x64_setcc_al(BIN_EQ); return 0; }
    if (t == NODE_BNOT) { x64_gen_expr(ast_a[n]); x64_not_rax(); return 0; }
