func util_mod(a, b) { return a - a / b * b; }

func util_strlen(p) {
    let int n = 0;
    while (util_mod(*p, 256)) { n = n + 1; p = p + 1; }
    return n;
}

func util_die(ln, msg) {
    print ln;
    syscall(SYS_WRITE, 1, msg, util_strlen(msg));
    syscall(SYS_EXIT, 1, 0, 0);
}

func lex_intern(p) {
    let int k = 0;
    let int o = 0;
    let int q = 0;
    while (k < lex_names_len) {
        q = p;
        o = k;
        while (lex_names[o] && (lex_names[o] == util_mod(*q, 256))) { o = o + 1; q = q + 1; }
        if ((lex_names[o] == 0) && (util_mod(*q, 256) == 0)) return k;
        while (lex_names[k]) k = k + 1;
        k = k + 1;
    }
    if (lex_names_len > 8000) util_die(0, "name overflow");
    o = lex_names_len;
    q = p;
    while (util_mod(*q, 256)) { lex_names[lex_names_len] = *q; lex_names_len = lex_names_len + 1; q = q + 1; }
    lex_names[lex_names_len] = 0; lex_names_len = lex_names_len + 1;
    return o;
}

func lex_intern_span(s, e) {
    let int k = 0;
    let int o = 0;
    let int j = 0;
    while (k < lex_names_len) {
        j = s;
        o = k;
        while ((j < e) && (lex_names[o] == lex_src[j])) { o = o + 1; j = j + 1; }
        if ((j == e) && (lex_names[o] == 0)) return k;
        while (lex_names[k]) k = k + 1;
        k = k + 1;
    }
    o = lex_names_len;
    while (s < e) { lex_names[lex_names_len] = lex_src[s]; lex_names_len = lex_names_len + 1; s = s + 1; }
    lex_names[lex_names_len] = 0; lex_names_len = lex_names_len + 1;
    return o;
}

func util_is_alpha(c) { return ((c >= 'A') && (c <= 'Z')) || ((c >= 'a') && (c <= 'z')) || (c == '_'); }
func util_is_digit(c) { return (c >= '0') && (c <= '9'); }
func util_is_xdigit(c)  { return util_is_digit(c) || ((c >= 'a') && (c <= 'f')) || ((c >= 'A') && (c <= 'F')); }

func lex_hex_number() {
    let int v = 0;
    let int c = 0;
    while (util_is_xdigit(lex_src[lex_src_pos])) {
        c = lex_src[lex_src_pos];
        if (c < 58) v = v * 16 + c - '0';
        else { if (c < 71) v = v * 16 + c - 55; else v = v * 16 + c - 87; }
        lex_src_pos = lex_src_pos + 1;
    }
    return v;
}

func util_peek8(p, i) { return util_mod(*(p + i), 256); }

func util_str_eq(p, q) {
    let int i = 0;
    while ((util_peek8(p, i) != 0) && (util_peek8(p, i) == util_peek8(q, i))) i = i + 1;
    return util_peek8(p, i) == util_peek8(q, i);
}

func lex_dec_number(p) {
    let int v = 0;
    let int i = 0;
    let int c = 0;
    let int hx = 0;
    if ((util_peek8(p, 0) == 48) && ((util_peek8(p, 1) == 120) || (util_peek8(p, 1) == 88))) { i = 2; hx = 1; }
    c = util_peek8(p, i);
    while (c) {
        if (hx) {
            if (c < 58) v = v * 16 + c - 48;
            else if (c < 71) v = v * 16 + c - 55;
            else v = v * 16 + c - 87;
        } else v = v * 10 + c - 48;
        i = i + 1;
        c = util_peek8(p, i);
    }
    return v;
}

func drv_argv(i) {
    if (i == 0) return argv1;
    if (i == 1) return argv2;
    if (i == 2) return argv3;
    if (i == 3) return argv4;
    if (i == 4) return argv5;
    if (i == 5) return argv6;
    if (i == 6) return argv7;
    if (i == 7) return argv8;
    return 0;
}

func lex_name_eq_span(s, e, k) {
    while (s < e) {
        if (lex_src[s] != lex_names[k]) return 0;
        s = s + 1; k = k + 1;
    }
    return lex_names[k] == 0;
}

func lex_add_token(t, v) {
    if (lex_ntok >= 32768) util_die(0, "token overflow");
    lex_tok_kind[lex_ntok] = t; lex_tok_value[lex_ntok] = v; lex_tok_line[lex_ntok] = lex_line; lex_ntok = lex_ntok + 1;
}


func lex_next_token() {
    let int c = lex_src[lex_src_pos];
    let int s = lex_src_pos;
    let int t = 0;
    let int v = 0;
    let int k = 0;
    if (c == '\n') lex_line = lex_line + 1;
    if ((c == ' ') || (c == '\t') || (c == 13) || (c == '\n')) { lex_src_pos = lex_src_pos + 1; return 0; }
    if ((c == '/') && (lex_src[lex_src_pos + 1] == '/')) {
        lex_src_pos = lex_src_pos + 2;
        while (lex_src[lex_src_pos] && (lex_src[lex_src_pos] != '\n')) lex_src_pos = lex_src_pos + 1;
        return 0;
    }
    if (util_is_alpha(c)) {
        lex_src_pos = lex_src_pos + 1;
        while ((lex_src_pos < lex_src_len) && (util_is_alpha(lex_src[lex_src_pos]) || util_is_digit(lex_src[lex_src_pos]))) lex_src_pos = lex_src_pos + 1;
        t = TOK_IDENT;
        while (k < 13) {
            if (lex_name_eq_span(s, lex_src_pos, lex_keywords[k])) t = k + 1;
            k = k + 1;
        }
        if ((t == TOK_IDENT) && lex_name_eq_span(s, lex_src_pos, lex_name_const)) t = TOK_CONST;
        if ((t == TOK_IDENT) && lex_name_eq_span(s, lex_src_pos, lex_name_for)) t = TOK_FOR;
        if (t == TOK_IDENT) v = lex_intern_span(s, lex_src_pos);
        lex_add_token(t, v);
        return 0;
    }
    if (util_is_digit(c)) {
        if ((c == '0') && (lex_src[lex_src_pos + 1] == 'x')) { lex_src_pos = lex_src_pos + 2; lex_add_token(TOK_NUM, lex_hex_number()); return 0; }
        while (util_is_digit(lex_src[lex_src_pos])) { v = v * 10 + lex_src[lex_src_pos] - '0'; lex_src_pos = lex_src_pos + 1; }
        lex_add_token(TOK_NUM, v);
        return 0;
    }
    if (c == '\'') {
        lex_src_pos = lex_src_pos + 1;
        lex_char = lex_src[lex_src_pos];
        if (lex_char == 92) {
            lex_src_pos = lex_src_pos + 1;
            lex_char = lex_src[lex_src_pos];
            if (lex_char == 110) lex_char = 10;
            if (lex_char == 116) lex_char = 9;
            if (lex_char == 48) lex_char = 0;
        }
        lex_src_pos = lex_src_pos + 1;
        if (lex_src[lex_src_pos] == '\'') lex_src_pos = lex_src_pos + 1;
        lex_add_token(TOK_NUM, lex_char);
        return 0;
    }
    if (c == '"') {
        lex_src_pos = lex_src_pos + 1;
        v = lex_nstr;
        while (lex_src[lex_src_pos] && (lex_src[lex_src_pos] != '"')) {
            lex_char = lex_src[lex_src_pos];
            if (lex_char == 92) {
                lex_src_pos = lex_src_pos + 1;
                lex_char = lex_src[lex_src_pos];
                if (lex_char == 110) lex_char = 10;
                if (lex_char == 116) lex_char = 9;
            }
            lex_strpool[lex_nstr] = lex_char; lex_nstr = lex_nstr + 1;
            lex_src_pos = lex_src_pos + 1;
        }
        lex_strpool[lex_nstr] = 0; lex_nstr = lex_nstr + 1;
        lex_src_pos = lex_src_pos + 1;
        lex_add_token(TOK_STR, v);
        return 0;
    }
    if (c > 127) util_die(lex_line, "bad character");
    if ((c == '&') && (lex_src[lex_src_pos + 1] == '&')) { lex_add_token(TOK_ANDAND, 0); lex_src_pos = lex_src_pos + 2; return 0; }
    if ((c == '|') && (lex_src[lex_src_pos + 1] == '|')) { lex_add_token(TOK_OROR, 0); lex_src_pos = lex_src_pos + 2; return 0; }
    if (((c == '<') || (c == '>')) && (lex_src[lex_src_pos + 1] == c)) {
        if (c == '<') lex_add_token(TOK_SHL, 0); else lex_add_token(TOK_SHR, 0);
        lex_src_pos = lex_src_pos + 2;
        return 0;
    }
    lex_next_eq = lex_src[lex_src_pos + 1] == '=';
    if (lex_next_eq && lex_punct2[c]) { lex_add_token(lex_punct2[c], 0); lex_src_pos = lex_src_pos + 2; return 0; }
    t = lex_punct1[c];
    if (t == 0) util_die(lex_line, "bad character");
    lex_add_token(t, 0);
    lex_src_pos = lex_src_pos + 1;
    return 0;
}

func drv_path_cat(dst, p) {
    while (util_peek8(p, 0)) { drv_path_buf[dst] = util_peek8(p, 0); dst = dst + 1; p = p + 1; }
    return dst;
}

func drv_path_dir(p) {
    let int o = drv_path_len;
    let int q = 0;
    let int i = 0;
    let int last = -1;
    while (util_peek8(p, i)) {
        if (util_peek8(p, i) == 47) last = i;
        i = i + 1;
    }
    if (last < 0) { drv_path_buf[drv_path_len] = 46; drv_path_len = drv_path_len + 1; drv_path_buf[drv_path_len] = 0; drv_path_len = drv_path_len + 1; return o; }
    q = 0;
    while (q < last) { drv_path_buf[drv_path_len] = util_peek8(p, q); drv_path_len = drv_path_len + 1; q = q + 1; }
    drv_path_buf[drv_path_len] = 0; drv_path_len = drv_path_len + 1;
    return o;
}

func drv_path_join(dirp, namep) {
    let int o = drv_path_len;
    let int q = o;
    q = drv_path_cat(q, dirp);
    drv_path_buf[q] = 47; q = q + 1;
    q = drv_path_cat(q, namep);
    drv_path_buf[q] = 0;
    drv_path_len = q + 1;
    return o;
}

func drv_import_mark(p) {
    if (drv_nimport >= 64) util_die(0, "too many imports");
    drv_import_names[drv_nimport] = lex_intern(p);
    drv_nimport = drv_nimport + 1;
}

func drv_import_seen(p) {
    let int k = lex_intern(p);
    let int i = 0;
    while (i < drv_nimport) {
        if (drv_import_names[i] == k) return 1;
        i = i + 1;
    }
    return 0;
}

func lex_import_here() {
    if (lex_ntok < 4) return 0;
    if (lex_tok_kind[lex_ntok - 4] != TOK_AT) return 0;
    if (lex_tok_kind[lex_ntok - 3] != TOK_IDENT) return 0;
    if (lex_tok_value[lex_ntok - 3] != lex_name_import) return 0;
    if (lex_tok_kind[lex_ntok - 2] != TOK_STR) return 0;
    if (lex_tok_kind[lex_ntok - 1] != TOK_SEMI) return 0;
    return 1;
}

func drv_load_file(fn) {
    let int st = 0;
    let int en = 0;
    let int dir = 0;
    let int full = 0;
    let int save_srci = 0;
    let int save_ln = 0;
    st = lex_src_len;
    out_fd = syscall(SYS_OPEN, fn, 0, 0);
    if (out_fd < 0) util_die(0, "cannot open input");
    en = st;
    while (1) {
        full = syscall(SYS_READ, out_fd, &lex_src[en], 65534);
        if (full <= 0) break;
        en = en + full;
    }
    syscall(SYS_CLOSE, out_fd, 0, 0);
    lex_src[en] = 0;
    lex_src_len = en + 1;
    dir = drv_path_dir(fn);
    save_srci = lex_src_pos; save_ln = lex_line;
    lex_src_pos = st; lex_line = 1;
    while (lex_src_pos < en) {
        lex_next_token();
        if (lex_import_here()) {
            full = drv_path_join(&drv_path_buf[dir], &lex_strpool[lex_tok_value[lex_ntok - 2]]);
            lex_ntok = lex_ntok - 4;
            if (drv_import_seen(&drv_path_buf[full]) == 0) {
                drv_import_mark(&drv_path_buf[full]);
                drv_load_file(&drv_path_buf[full]);
            }
        }
    }
    lex_src_pos = save_srci; lex_line = save_ln;
    return 0;
}


func ast_new(t, a, b, v) {
    if (ast_n >= 16384) util_die(0, "node overflow");
    ast_kind[ast_n] = t; ast_a[ast_n] = a; ast_b[ast_n] = b; ast_v[ast_n] = v;
    ast_next[ast_n] = 0; ast_c[ast_n] = 0;
    ast_n = ast_n + 1;
    return ast_n - 1;
}

func ast_append(h, x) {
    let int t = h;
    if (h == 0) return x;
    while (ast_next[t]) t = ast_next[t];
    ast_next[t] = x;
    return h;
}

func parse_tok() { return lex_tok_kind[parse_tok_pos]; }

func parse_eat(t, msg) {
    if (lex_tok_kind[parse_tok_pos] != t) util_die(lex_tok_line[parse_tok_pos], msg);
    parse_tok_pos = parse_tok_pos + 1;
}

func type_elem_size(t) { return util_mod(t / VAL_U32, 256); }
func type_kind(t) { return t / TYPE_CODE_PTR; }
func type_size(t) { return t - t / VAL_U32 * VAL_U32; }
func type_is_char(t) { return (type_kind(t) == 0) && (type_elem_size(t) == 1); }
func type_is_str(t) { return (type_kind(t) == 1) && (type_elem_size(t) == 1); }   
func type_pointer(b) { return TYPE_CODE_PTR + type_elem_size(b) * VAL_U32 + 8; }
func type_array(n, b) { return TYPE_CODE_ARR + type_size(b) * VAL_U32 + n * type_size(b); }

func parse_type() {
    emit_tmp1 = TYPE_INT;
    if (parse_tok() == TOK_CHAR) { emit_tmp1 = TYPE_CHAR; parse_tok_pos = parse_tok_pos + 1; }
    else parse_eat(TOK_INT, "type expected");
    while (parse_tok() == TOK_STAR) { parse_tok_pos = parse_tok_pos + 1; emit_tmp1 = type_pointer(emit_tmp1); }
    while (parse_tok() == TOK_LBRACKET) {
        parse_tok_pos = parse_tok_pos + 1;
        parse_eat(TOK_NUM, "array size");
        emit_tmp2 = lex_tok_value[parse_tok_pos - 1];
        parse_eat(TOK_RBRACKET, "expected ]");
        emit_tmp1 = type_array(emit_tmp2, emit_tmp1);
    }
    return emit_tmp1;
}

func parse_primary() {
    let int a = 0;
    let int b = 0;
    let int c = 0;
    let int k = 0;
    if (parse_tok() == TOK_NUM) { c = ast_new(NODE_NUMBER, 0, 0, lex_tok_value[parse_tok_pos]); parse_tok_pos = parse_tok_pos + 1; return c; }
    if (parse_tok() == TOK_IDENT) {
        c = lex_tok_value[parse_tok_pos];
        k = 0;
        while (k < sym_nconst) {
            if (sym_const_name[k] == c) { parse_tok_pos = parse_tok_pos + 1; return ast_new(NODE_NUMBER, 0, 0, sym_const_value[k]); }
            k = k + 1;
        }
        parse_tok_pos = parse_tok_pos + 1;
        if (parse_tok() != TOK_LPAREN) return ast_new(NODE_VARIABLE, 0, 0, c);
        parse_tok_pos = parse_tok_pos + 1;
        if (parse_tok() != TOK_RPAREN) {
            b = parse_expr();
            a = 1;
            while (parse_tok() == TOK_COMMA) {
                parse_tok_pos = parse_tok_pos + 1;
                b = ast_append(b, parse_expr());
                a = a + 1;
            }
        }
        parse_eat(TOK_RPAREN, "expected )");
        return ast_new(NODE_CALL, b, a, c);
    }
    if (parse_tok() == TOK_STR) { c = ast_new(NODE_STR, 0, 0, lex_tok_value[parse_tok_pos]); parse_tok_pos = parse_tok_pos + 1; return c; }
    if (parse_tok() == TOK_LPAREN) { parse_tok_pos = parse_tok_pos + 1; c = parse_expr(); parse_eat(TOK_RPAREN, "expected )"); return c; }
    util_die(lex_tok_line[parse_tok_pos], "syntax error");
    return 0;
}

func parse_postfix() {
    let int n = parse_primary();
    while (parse_tok() == TOK_LBRACKET) {
        parse_tok_pos = parse_tok_pos + 1;
        n = ast_new(NODE_INDEX, n, parse_expr(), 0);
        parse_eat(TOK_RBRACKET, "expected ]");
    }
    return n;
}

func parse_unary() {
    let int n = 0;
    if (parse_tok() == TOK_MINUS) { parse_tok_pos = parse_tok_pos + 1; n = ast_new(NODE_NUMBER, 0, 0, 0); return ast_new(NODE_BINARY, n, parse_unary(), BIN_SUB); }
    if (parse_tok() == TOK_NOT)  { parse_tok_pos = parse_tok_pos + 1; return ast_new(NODE_NOT, parse_unary(), 0, 0); }
    if (parse_tok() == TOK_AMP)  { parse_tok_pos = parse_tok_pos + 1; return ast_new(NODE_ADDR, parse_unary(), 0, 0); }
    if (parse_tok() == TOK_STAR) { parse_tok_pos = parse_tok_pos + 1; return ast_new(NODE_DEREF, parse_unary(), 0, 0); }
    if (parse_tok() == TOK_SIZEOF) { parse_tok_pos = parse_tok_pos + 1; return ast_new(NODE_SIZEOF, parse_unary(), 0, 0); }
    if (parse_tok() == TOK_TILDE) { parse_tok_pos = parse_tok_pos + 1; return ast_new(NODE_BNOT, parse_unary(), 0, 0); }
    return parse_postfix();
}

func parse_binary(m) {
    let int n = parse_unary();
    let int e = 0;
    while (parse_binop[parse_tok()] && (parse_binop[parse_tok()] / 32 >= m)) {
        e = parse_binop[parse_tok()];
        parse_tok_pos = parse_tok_pos + 1;
        n = ast_new(NODE_BINARY, n, parse_binary(e / 32 + 1), e - e / 32 * 32);
    }
    return n;
}

func parse_expr() {
    let int n = parse_binary(0);
    let int c = 0;
    if (parse_tok() == TOK_ASSIGN) c = 1;
    else if (parse_tok() == TOK_PLUS_EQ) c = BIN_ADD + 2;
    else if (parse_tok() == TOK_MINUS_EQ) c = BIN_SUB + 2;
    else if (parse_tok() == TOK_STAR_EQ) c = BIN_MUL + 2;
    else if (parse_tok() == TOK_SLASH_EQ) c = BIN_DIV + 2;
    else if (parse_tok() == TOK_PERCENT_EQ) c = BIN_MOD + 2;
    if (c == 0) return n;
    parse_tok_pos = parse_tok_pos + 1;
    return ast_new(NODE_ASSIGN, n, parse_expr(), c - 1);
}

func parse_stmt() {
    let int n = 0;
    let int pc = 0;
    let int i = 0;
    let int t = parse_tok();
    if (t == TOK_CONST) {
        parse_tok_pos = parse_tok_pos + 1;
        parse_eat(TOK_IDENT, "const name");
        sym_const_name[sym_nconst] = lex_tok_value[parse_tok_pos - 1];
        parse_eat(TOK_ASSIGN, "expected =");
        parse_eat(TOK_NUM, "const must be number");
        sym_const_value[sym_nconst] = lex_tok_value[parse_tok_pos - 1];
        sym_nconst = sym_nconst + 1;
        parse_eat(TOK_SEMI, "expected ;");
        return ast_new(NODE_BLOCK, 0, 0, 0);
    }
    if (t == TOK_LET) {
        parse_tok_pos = parse_tok_pos + 1;
        n = ast_new(NODE_LET, 0, TYPE_INT, 0);
        if ((parse_tok() == TOK_INT) || (parse_tok() == TOK_CHAR)) ast_b[n] = parse_type();
        parse_eat(TOK_IDENT, "var name");
        ast_v[n] = lex_tok_value[parse_tok_pos - 1];
        while (parse_tok() == TOK_LBRACKET) {
            parse_tok_pos = parse_tok_pos + 1;
            parse_eat(TOK_NUM, "array size");
            emit_tmp2 = lex_tok_value[parse_tok_pos - 1];
            parse_eat(TOK_RBRACKET, "expected ]");
            ast_b[n] = type_array(emit_tmp2, ast_b[n]);
        }
        if (parse_tok() == TOK_ASSIGN) { parse_tok_pos = parse_tok_pos + 1; ast_a[n] = parse_expr(); }
        parse_eat(TOK_SEMI, "expected ;");
        return n;
    }
    if (t == TOK_PRINT) {
        parse_tok_pos = parse_tok_pos + 1;
        n = ast_new(NODE_PRINT, 0, 0, 0);
        pc = 1;
        i = parse_expr();
        while (parse_tok() == TOK_COMMA) {
            parse_tok_pos = parse_tok_pos + 1;
            i = ast_append(i, parse_expr());
            pc = pc + 1;
        }
        ast_a[n] = i; ast_b[n] = pc;
        parse_eat(TOK_SEMI, "expected ;");
        return n;
    }
    if (t == TOK_IF) {
        parse_tok_pos = parse_tok_pos + 1;
        parse_eat(TOK_LPAREN, "expected (");
        n = ast_new(NODE_IF, parse_expr(), 0, 0);
        parse_eat(TOK_RPAREN, "expected )");
        ast_b[n] = parse_stmt();
        if (parse_tok() == TOK_ELSE) { parse_tok_pos = parse_tok_pos + 1; ast_v[n] = parse_stmt(); }
        return n;
    }
    if (t == TOK_WHILE) {
        parse_tok_pos = parse_tok_pos + 1;
        parse_eat(TOK_LPAREN, "expected (");
        n = ast_new(NODE_WHILE, parse_expr(), 0, 0);
        parse_eat(TOK_RPAREN, "expected )");
        ast_b[n] = parse_stmt();
        return n;
    }
    if (t == TOK_FOR) {
        parse_tok_pos = parse_tok_pos + 1;
        parse_eat(TOK_LPAREN, "expected (");
        n = ast_new(NODE_FOR, 0, 0, 0);
        if (parse_tok() != TOK_SEMI) ast_a[n] = parse_stmt();      
        else parse_tok_pos = parse_tok_pos + 1;
        if (parse_tok() != TOK_SEMI) ast_b[n] = parse_expr();     
        parse_eat(TOK_SEMI, "expected ;");
        if (parse_tok() != TOK_RPAREN) ast_v[n] = parse_expr();       
        parse_eat(TOK_RPAREN, "expected )");
        ast_c[n] = parse_stmt();                           
        return n;
    }
    if (t == TOK_BREAK) { parse_tok_pos = parse_tok_pos + 1; parse_eat(TOK_SEMI, "expected ;"); return ast_new(NODE_BREAK, 0, 0, 0); }
    if (t == TOK_CONTINUE) { parse_tok_pos = parse_tok_pos + 1; parse_eat(TOK_SEMI, "expected ;"); return ast_new(NODE_CONTINUE, 0, 0, 0); }
    if (t == TOK_RETURN) { parse_tok_pos = parse_tok_pos + 1; n = ast_new(NODE_RETURN, parse_expr(), 0, 0); parse_eat(TOK_SEMI, "expected ;"); return n; }
    if (t == TOK_LBRACE) {
        parse_tok_pos = parse_tok_pos + 1;
        n = 0;
        while ((parse_tok() != TOK_RBRACE) && (parse_tok() != TOK_EOF)) n = ast_append(n, parse_stmt());
        parse_eat(TOK_RBRACE, "expected }");
        return ast_new(NODE_BLOCK, n, 0, 0);
    }
    if (t == TOK_EXTERN) {
        parse_tok_pos = parse_tok_pos + 1;
        if (parse_tok() == TOK_FUNC) {
            parse_tok_pos = parse_tok_pos + 1;
            parse_eat(TOK_IDENT, "extern func name");
            n = ast_new(NODE_EXTERN_FUNC, 0, 0, lex_tok_value[parse_tok_pos - 1]);
            parse_eat(TOK_LPAREN, "expected (");
            if (parse_tok() != TOK_RPAREN) {
                parse_eat(TOK_IDENT, "param name");
                pc = 1;
                while (parse_tok() == TOK_COMMA) { parse_tok_pos = parse_tok_pos + 1; parse_eat(TOK_IDENT, "param name"); pc = pc + 1; }
            }
            parse_eat(TOK_RPAREN, "expected )");
            ast_b[n] = pc;
            parse_eat(TOK_SEMI, "expected ;");
            return n;
        }
        if (parse_tok() == TOK_LET) {
            parse_tok_pos = parse_tok_pos + 1;
            parse_eat(TOK_IDENT, "extern let name");
            n = ast_new(NODE_EXTERN_GLOB, 0, 0, lex_tok_value[parse_tok_pos - 1]);
            parse_eat(TOK_SEMI, "expected ;");
            return n;
        }
        util_die(lex_tok_line[parse_tok_pos], "expected func or let after extern");
    }
    if (t == TOK_FUNC) util_die(lex_tok_line[parse_tok_pos], "func must be top-level");
    n = parse_expr();
    parse_eat(TOK_SEMI, "expected ;");
    return n;
}

func parse_func() {
    let int n = 0;
    let int pc = 0;
    let int h = 0;
    parse_tok_pos = parse_tok_pos + 1;
    parse_eat(TOK_IDENT, "func name");
    n = ast_new(NODE_FUNCTION, 0, 0, lex_tok_value[parse_tok_pos - 1]);
    parse_eat(TOK_LPAREN, "expected (");
    if (parse_tok() != TOK_RPAREN) {
        parse_eat(TOK_IDENT, "param name");
        h = ast_new(NODE_VARIABLE, 0, 0, lex_tok_value[parse_tok_pos - 1]);
        pc = 1;
        while (parse_tok() == TOK_COMMA) {
            parse_tok_pos = parse_tok_pos + 1;
            parse_eat(TOK_IDENT, "param name");
            h = ast_append(h, ast_new(NODE_VARIABLE, 0, 0, lex_tok_value[parse_tok_pos - 1]));
            pc = pc + 1;
        }
    }
    parse_eat(TOK_RPAREN, "expected )");
    ast_a[n] = h;
    ast_b[n] = parse_stmt();
    return n;
}

func parse_directive() {
    let int d = 0;
    parse_tok_pos = parse_tok_pos + 1;
    if (parse_tok() != TOK_IDENT) util_die(lex_tok_line[parse_tok_pos], "directive name expected");
    d = lex_tok_value[parse_tok_pos];
    parse_tok_pos = parse_tok_pos + 1;
    if (d == lex_name_base) {
        if (parse_tok() != TOK_NUM) util_die(lex_tok_line[parse_tok_pos], "@base needs a number");
        out_load_base = lex_tok_value[parse_tok_pos];
        parse_tok_pos = parse_tok_pos + 1;
    } else if (d == lex_name_entry) {
        if (parse_tok() != TOK_IDENT) util_die(lex_tok_line[parse_tok_pos], "@entry needs a symbol");
        out_entry_name = lex_tok_value[parse_tok_pos];
        parse_tok_pos = parse_tok_pos + 1;
    } else if (d == lex_name_bin) out_format = 1;
    else if (d == lex_name_elf) out_format = 0;
    else if (d == lex_name_nort) out_freestanding = 1;
    else if (d == lex_name_raw) out_raw_mode = 1;
    else if (d == lex_name_boot) out_boot_mode = 1;
    else util_die(lex_tok_line[parse_tok_pos], "unknown directive");
    parse_eat(TOK_SEMI, "expected ; after directive");
    return 0;
}

func parse_program() {
    let int h = 0;
    while (parse_tok() != TOK_EOF) {
        if (parse_tok() == TOK_AT) parse_directive();
        else if (parse_tok() == TOK_FUNC) h = ast_append(h, parse_func());
        else h = ast_append(h, parse_stmt());
    }
    return ast_new(NODE_BLOCK, h, 0, 0);
}


func sym_local_find(nm) {
    let int i = sym_nlocal - 1;
    while (i >= 0) {
        if (sym_local_name[i] == nm) return i;
        i = i - 1;
    }
    return -1;
}

func sym_local_add(nm, t) {
    if (sym_nlocal >= 512) util_die(0, "local overflow");
    sym_frame_off = sym_frame_off - type_size(t);
    sym_local_name[sym_nlocal] = nm; sym_local_ty[sym_nlocal] = t; sym_local_off[sym_nlocal] = sym_frame_off;
    sym_nlocal = sym_nlocal + 1;
    return sym_nlocal - 1;
}

func sym_global_find(nm) {
    let int i = 0;
    while (i < sym_nglobal) {
        if (sym_global_name[i] == nm) return i;
        i = i + 1;
    }
    return -1;
}

func sym_global_add(nm, t) {
    if (sym_nglobal >= 256) util_die(0, "glob overflow");
    sym_global_name[sym_nglobal] = nm; sym_global_ty[sym_nglobal] = t; sym_global_off[sym_nglobal] = sym_global_size;
    sym_global_size = sym_global_size + type_size(t);
    sym_nglobal = sym_nglobal + 1;
}

func sym_func_find(nm) {
    let int i = 0;
    while (i < sym_nfunc) {
        if (sym_func_name[i] == nm) return i;
        i = i + 1;
    }
    return -1;
}

func type_of_expr(n) {
    let int t = ast_kind[n];
    let int i = 0;
    if (t == NODE_VARIABLE) {
        i = sym_local_find(ast_v[n]);
        if (i >= 0) return sym_local_ty[i];
        i = sym_global_find(ast_v[n]);
        if (i >= 0) return sym_global_ty[i];
        return TYPE_INT;
    }
    if (t == NODE_STR) return type_pointer(TYPE_CHAR);
    if (t == NODE_ADDR) return type_pointer(type_of_expr(ast_a[n]));
    if ((t == NODE_DEREF) || (t == NODE_INDEX)) {
        t = type_of_expr(ast_a[n]);
        if (type_kind(t) > 0) {
            if (type_elem_size(t) == 1) return TYPE_CHAR;
            return TYPE_INT;
        }
        return TYPE_INT;
    }
    return TYPE_INT;
}

func type_size_of_expr(n) {
    if (ast_kind[n] == NODE_VARIABLE) return type_size(type_of_expr(n));
    return 8;
}


func emit_u8(v) {
    if (emit_len > OUT_CODE_MAX) util_die(0, "code overflow");
    emit_buf[emit_hdr_size + emit_len] = v;
    emit_len = emit_len + 1;
}

func emit_u32_bytes(v) { emit_u8(v); emit_u8(v >> 8); emit_u8(v >> 16); emit_u8(v >> 24); }
func emit_u32(v) {
    if (v < 0) v = v + VAL_U32;
    emit_u32_bytes(v);
}
func emit_u64(v) { emit_u32_bytes(v); emit_u32_bytes(v >> 32); }

func emit_poke32(pos, v) {
    if (v < 0) v = v + VAL_U32;
    emit_buf[emit_hdr_size + pos] = v;
    emit_buf[emit_hdr_size + 1 + pos] = v / 256;
    emit_buf[emit_hdr_size + 2 + pos] = v / 65536;
    emit_buf[emit_hdr_size + 3 + pos] = v / 16777216;
}

func out_put16(o, v) { emit_buf[o] = v; emit_buf[o + 1] = v / 256; }
func out_put32(o, v) { out_put16(o, v); out_put16(o + 2, v / 65536); }
func out_put64(o, v) { out_put32(o, v); out_put32(o + 4, v / VAL_U32); }

func x64_reg_add(nm, ix) { x64_reg_name[x64_nreg] = lex_intern(nm); x64_reg_index[x64_nreg] = ix; x64_nreg = x64_nreg + 1; return 0; }

func raw_arg(a) {
    let int k = 0;
    if (ast_kind[a] == NODE_VARIABLE) {
        k = 0;
        while (k < x64_nreg) {
            if (ast_v[a] == x64_reg_name[k]) return x64_reg_index[k];
            k = k + 1;
        }
    }
    if (ast_kind[a] != NODE_NUMBER) util_die(0, "intrinsic argument must be a constant");
    return ast_v[a];
}

func emit_raw_defer(k, id, pos) {
    if (out_raw_mode == 0) util_die(0, "raw label intrinsics are only valid in @raw mode");
    if (raw_npatch >= 128) util_die(0, "too many raw patches");
    raw_patch_kind[raw_npatch] = k; raw_patch_id[raw_npatch] = id; raw_patch_pos[raw_npatch] = pos; raw_npatch = raw_npatch + 1;
    return 0;
}

func emit_raw_apply() {
    let int i = 0;
    let int p = 0;
    let int id = 0;
    let int v = 0;
    let int rel = 0;
    while (i < raw_npatch) {
        p = raw_patch_pos[i]; id = raw_patch_id[i];
        if ((id < 0) || (id >= 64) || (raw_label_ok[id] == 0)) util_die(0, "undefined raw label");
        if (raw_patch_kind[i] == 0) {
            rel = raw_labels[id] - p - 1;
            if (rel < -128) util_die(0, "raw branch out of range");
            if (rel > 127) util_die(0, "raw branch out of range");
            emit_buf[emit_hdr_size + p] = rel;
        } else {
            v = 0x7C00 + raw_labels[id];
            if (raw_patch_kind[i] == 1) { emit_buf[emit_hdr_size + p] = v; emit_buf[emit_hdr_size + p + 1] = v / 256; }
            else emit_poke32(p, v);
        }
        i = i + 1;
    }
    return 0;
}

func x64_mov_imm(v) {
    if (v == 0) { emit_u8(72); emit_u8(49); emit_u8(192); return 0; }
    if ((v >= -128) && (v <= 127)) { emit_u8(106); emit_u8(v); emit_u8(88); return 0; }
    if ((v >= 0) && (v <= 4294967295)) { emit_u8(184); emit_u32(v); return 0; }
    if ((v >= -2147483648) && (v <= -1)) { emit_u8(72); emit_u8(199); emit_u32(v); return 0; }
    emit_u8(72); emit_u8(184); emit_u64(v);
    return 0;
}

func emit_new_label() {
    if (emit_nlabel >= 2048) util_die(0, "label overflow");
    emit_nlabel = emit_nlabel + 1;
    return emit_nlabel - 1;
}
func emit_put_label(l) { emit_label_pos[l] = emit_len; }
func emit_patch(k, v) {
    if (emit_npatch >= 8192) util_die(0, "patch overflow");
    emit_patch_pos[emit_npatch] = emit_len; emit_patch_value[emit_npatch] = v; emit_patch_kind[emit_npatch] = k;
    emit_npatch = emit_npatch + 1;
    emit_len = emit_len + 4;
}

func x64_setcc_of(op) {
    if (op < 6) return 144 + op;
    return 156 + util_mod(10 - op, 4);
}


func x64_lea_rbp(off)      { emit_u8(72); emit_u8(141); emit_u8(69); emit_u8(off); }
func x64_lea_rip_glob(g)   { emit_u8(72); emit_u8(141); emit_u8(5); emit_patch(2, g); }
func x64_load_rbp(off)     { emit_u8(72); emit_u8(139); emit_u8(69); emit_u8(off); }
func x64_loadz_rbp(off)    { emit_u8(15); emit_u8(182); emit_u8(69); emit_u8(off); }
func x64_load_glob(g)      { emit_u8(72); emit_u8(139); emit_u8(5); emit_patch(2, g); }
func x64_loadz_glob(g)     { emit_u8(15); emit_u8(182); emit_u8(5); emit_patch(2, g); }
func x64_load_rax()        { emit_u8(72); emit_u8(139); emit_u8(0); }
func x64_loadz_rax()       { emit_u8(15); emit_u8(182); emit_u8(0); }
func x64_store_rbx_byte()  { emit_u8(136); emit_u8(3); }
func x64_store_rbx_q()     { emit_u8(72); emit_u8(137); emit_u8(3); }
func x64_store_rbp(off)    { emit_u8(72); emit_u8(137); emit_u8(69); emit_u8(off); }
func x64_store_rdi()       { emit_u8(72); emit_u8(137); emit_u8(7); }
func x64_store_glob(g)     { emit_u8(72); emit_u8(137); emit_u8(5); emit_patch(2, g); }
func x64_store_glob_byte(g){ emit_u8(136); emit_u8(5); emit_patch(2, g); }
func x64_lea_rdi_rbp(off)  { emit_u8(72); emit_u8(141); emit_u8(125); emit_u8(off); }
func x64_push_rax()        { emit_u8(80); }
func x64_pop_rbx()         { emit_u8(91); }
func x64_mov_rdi_rax()     { emit_u8(72); emit_u8(137); emit_u8(199); }
func x64_mov_rax_rdi()     { emit_u8(72); emit_u8(137); emit_u8(248); }
func x64_mov_rax_rsp(o)    { emit_u8(72); emit_u8(139); emit_u8(68); emit_u8(36); emit_u8(o); }
func x64_test_rax()        { emit_u8(72); emit_u8(133); emit_u8(192); }
func x64_cmp_rax_rbx()     { emit_u8(72); emit_u8(57); emit_u8(216); }
func x64_cmp_rax_rcx()     { emit_u8(72); emit_u8(57); emit_u8(200); }
func x64_cmp_rax_imm(v) {
    if ((v >= -128) && (v <= 127)) { emit_u8(72); emit_u8(131); emit_u8(248); emit_u8(v); return 0; }
    if ((v >= -2147483648) && (v <= 2147483647)) { emit_u8(72); emit_u8(61); emit_u32(v); return 0; }
    emit_u8(72); emit_u8(185); emit_u64(v);
    emit_u8(72); emit_u8(57); emit_u8(200);
    return 0;
}
func x64_add_rax_rcx()     { emit_u8(72); emit_u8(1); emit_u8(200); }
func x64_sub_rax_rcx()     { emit_u8(72); emit_u8(41); emit_u8(200); }
func x64_mul_rax_rcx()     { emit_u8(72); emit_u8(15); emit_u8(175); emit_u8(193); }
func x64_div_rcx()         { emit_u8(72); emit_u8(153); emit_u8(72); emit_u8(247); emit_u8(249); }
func x64_add_rbx_rax()     { emit_u8(72); emit_u8(1); emit_u8(216); }
func x64_sub_rbx_rax()     { emit_u8(72); emit_u8(147); emit_u8(72); emit_u8(41); emit_u8(216); }
func x64_mul_rbx()         { emit_u8(72); emit_u8(15); emit_u8(175); emit_u8(195); }
func x64_div_rbx()         { emit_u8(72); emit_u8(147); emit_u8(72); emit_u8(153); emit_u8(72); emit_u8(247); emit_u8(251); }
func x64_or_rax_rcx()      { emit_u8(72); emit_u8(9); emit_u8(200); }
func x64_and_rax_rcx()     { emit_u8(72); emit_u8(33); emit_u8(200); }
func x64_xor_rax_rcx()     { emit_u8(72); emit_u8(49); emit_u8(200); }
func x64_shl_rax_cl()      { emit_u8(72); emit_u8(211); emit_u8(224); }
func x64_sar_rax_cl()      { emit_u8(72); emit_u8(211); emit_u8(248); }
func x64_or_rax_rbx()      { emit_u8(72); emit_u8(9); emit_u8(216); }
func x64_and_rax_rbx()     { emit_u8(72); emit_u8(33); emit_u8(216); }
func x64_xor_rax_rbx()     { emit_u8(72); emit_u8(49); emit_u8(216); }
func x64_xchg_rax_rbx()    { emit_u8(72); emit_u8(147); }
