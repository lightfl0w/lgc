type Point = { x: int, y: int };

fn bump(p: *int) -> int {
    *p = *p + 1;
    return *p;
}

fn make() -> own Point {
    let p: own Point = new Point;
    p.x = 1;
    p.y = 2;
    return p;
}

fn main() -> int {
    let x = 41;
    bump(&x);
    print "x=", x, "\n";

    let a: own Point = make();
    print "p=", a.x, ",", a.y, "\n";
    let b = a;
    print "moved=", b.x + b.y, "\n";
    drop b;

    let n: own int = new int;
    *n = 7;
    print "n=", *n, "\n";
    drop n;

    let arr: [3]int = { 1, 2, 3 };
    print "arr=", arr[0], arr[1], arr[2], "\n";
    return 0;
}
