struct Point { int x; int y; };
struct Pair { int a; struct Point origin; };

func grade(x) {
    switch (x) {
        case 0: print "F\n"; break;
        case 1: print "D\n"; break;
        case 2: print "C\n"; break;
        case 3: print "B\n"; break;
        case 4: print "A\n"; break;
        default: print "?\n";
    }
}

let struct Point p;
p.x = 3;
p.y = 4;
print "pt ", p.x, ",", p.y, " d2=", p.x * p.x + p.y * p.y, "\n";

let struct Point pts[3];
let i = 0;
for (i = 0; i < 3; i += 1) { pts[i].x = i * 10; pts[i].y = i + 1; }
print "pts ", pts[0].x, pts[0].y, " ", pts[2].x, pts[2].y, "\n";

let struct Pair q;
q.a = 7; q.origin.x = 1; q.origin.y = 2;
print "pair ", q.a, " ", q.origin.x + q.origin.y, "\n";

let g = 0;
for (let k = 0; k < 5; k += 1) {
    if (k == 2) continue;
    if (k == 4) break;
    g += k;
}
print "g=", g, "\n";

grade(0); grade(2); grade(4); grade(9);
