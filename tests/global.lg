let char* msg;
let int acc;
let int counter;
let char buf[4];

func add3(a, b, c) { return a + b + c; }
func mul(a, b) { return a * b; }

msg = "globals+str+syscall ok\n";
syscall(1, 1, msg, 24);
syscall(1, 1, "multi-arg: 6*7=42\n", 19);

print add3(1, 2, 3);
print mul(6, 7);

counter = 0;
acc = 0;
while (counter < 5) {
    acc = acc + counter;
    counter = counter + 1;
}
print acc;

buf[0] = 65;
buf[1] = 66;
print buf[0];
print buf[1];
print sizeof buf;
print sizeof msg;
