func main() {
  let int a = 12;
  let int b = 10;
  print a | b;
  print a & b;
  print a ^ b;
  print ~a;
  print 1 << 5;
  print 1024 >> 3;
  print a & 1 | 2;
  let int i = 0;
  let int s = 0;
  while (1) {
    i = i + 1;
    if (i > 10) break;
    if (i & 1) continue;
    s = s + i;
  }
  print s;
  print i;
  return 0;
}
