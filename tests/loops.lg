let int s = 0;
let int i = 0;

for (let k = 0; k < 5; k += 1) { s += k; }
print "s=", s, "\n";

for (i = 0; i < 10; i += 1) {
    if (i == 3) { continue; }
    if (i == 8) { break; }
    s += i;
}
print "s2=", s, "\n";

