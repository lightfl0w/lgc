@raw;
const L_ERR = 0; const L_PM32 = 1; const L_LM64 = 2; const L_GDT = 3; const L_DESC = 4;

cli();
xor16(AX, AX);
setseg(DS, AX); setseg(ES, AX); setseg(SS, AX);
set16(SP, 0x7C00);
set16(AX, 0x1000);
setseg(ES, AX);
xor16(BX, BX);
set8(AH, 2);
set8(AL, 16);
set8(CH, 0);
set8(CL, 2);
set8(DH, 0);
int_n(0x13);
jc(L_ERR);

in_al(0x92);
or8(AL, 2);
out_al(0x92);
lgdt_at(L_DESC);

readcr(CR0, EAX);
or8(AL, 1);
writecr(CR0, EAX);
ljmp16(0x08, L_PM32);

label(L_ERR);
hlt();
jmp(L_ERR);

label(L_PM32);
set32(EAX, 0x10);
setseg(DS, EAX); setseg(ES, EAX); setseg(SS, EAX);
set32(ESP, 0x7C00);

setmem32(0x1000, 0x2003);  setmem32(0x1004, 0);
setmem32(0x2000, 0x3003);  setmem32(0x2004, 0);
setmem32(0x3000, 0x0083);  setmem32(0x3004, 0);

readcr(CR4, EAX);
or32(EAX, 0x20);
writecr(CR4, EAX);
set32(EAX, 0x1000);
writecr(CR3, EAX);

set32(ECX, 0xC0000080);
rdmsr();
or32(EAX, 0x100);
wrmsr();

readcr(CR0, EAX);
or32(EAX, 0x80000001);
writecr(CR0, EAX);
ljmp32(0x18, L_LM64);

label(L_LM64);
set32(EAX, 0x10);
setseg(DS, EAX); setseg(ES, EAX); setseg(SS, EAX);
set64(ESP, 0x80000);
cld();
set32(ESI, 0x10000);
set32(EDI, 0x100000);
set32(ECX, 1024);
rep_movsq();
set32(EAX, 0x100000);
jmp_rax();

label(L_GDT);
asm(
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0xFF, 0xFF, 0x00, 0x00, 0x00, 0x9A, 0xCF, 0x00,
    0xFF, 0xFF, 0x00, 0x00, 0x00, 0x92, 0xCF, 0x00,
    0xFF, 0xFF, 0x00, 0x00, 0x00, 0x9A, 0xAF, 0x00
);
label(L_DESC);
gdt_desc16(L_GDT, 32);