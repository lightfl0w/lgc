let dig: [80]int;
let nd = 0;

fn dmul(k: int) -> int {
    let i = 0;
    let c = 0;
    while (i < nd) {
        let t = dig[i] * k + c;
        dig[i] = t % 10;
        c = t / 10;
        i += 1;
    }
    while (c > 0) {
        dig[nd] = c % 10;
        c = c / 10;
        nd += 1;
    }
    return 0;
}

fn facbig(n: int) -> int {
    dig[0] = 1;
    nd = 1;
    let k = 2;
    while (k <= n) {
        dmul(k);
        k += 1;
    }
    return 0;
}

fn dprint() -> int {
    let i = nd;
    while (i > 0) {
        i -= 1;
        print dig[i];
    }
    return 0;
}

facbig(50);
dprint();
print "\n";
