@nort;
@base 0x100000;
@entry _start;
@bin;

let vid: *char = 0xB8000;
let ticks = 0;

fn putc(ch: int, pos: int) -> int {
    vid[pos * 2] = ch;
    vid[pos * 2 + 1] = 7;
    return 0;
}

fn _start() -> int {
    cli();
    asm(0xFA, 0xFB);
    hlt();
    lgdt(0x1000);
    lidt(0x2000);
    setcr3(0x3000);
    outb(0x3F8, 72);
    let v = inb(0x3F8);
    putc(65, 0);
    ticks = ticks + 1;
    sti();
    iretq();
    return v;
}
